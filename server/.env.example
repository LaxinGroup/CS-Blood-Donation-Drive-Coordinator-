# Copy to server/.env and fill in. Never commit server/.env.

# Neon connection string (Neon console > Connection Details). SSL is switched on automatically for neon.tech.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me

PORT=5000
NODE_ENV=development

# The frontend that may call this API (CORS). Localhost, *.vercel.app and *.onrender.com are already allowed.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma separated (optional).
ALLOWED_ORIGINS=

# Password reset emails (Brevo transactional API). FRONTEND_URL above is used as the reset-link base.
# Brevo > SMTP & API > API Keys. Leave empty in development to print reset links to the server console.
BREVO_API_KEY=
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders).
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIL_FROM_NAME=CS Blood Donation Drive
