# Copy to client/my-app/.env.local and fill in.
# The backend API the browser calls; "/api" is added when missing.
# Local:    http://localhost:5000/api
# Deployed: https://<your-backend>.onrender.com/api
# NEXT_PUBLIC_ values are built into the page: change them, then restart `npm run dev` or rebuild.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
