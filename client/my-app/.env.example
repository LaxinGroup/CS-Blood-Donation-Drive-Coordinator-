# Copy to client/my-app/.env.local and fill in.
# The backend API the browser calls; "/api" is added when missing.
# Local:    http://localhost:5000/api
# Deployed: https://<your-backend>.onrender.com/api
# NEXT_PUBLIC_ values are built into the page: change them, then restart `npm run dev` or rebuild.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Neon Auth (Neon console > Auth > Configuration). Server-only: never prefix these with NEXT_PUBLIC_.
# Auth URL, including its path, e.g. https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Encrypts the session cookie. 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
